# ── Supabase (identity: sign-up, email verification, sign-in, password reset) ──
# Project settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key   # or VITE_SUPABASE_PUBLISHABLE_KEY

# Server only — never expose this to the browser bundle.
# Used to validate access tokens and to remove users during cleanup.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-key     # or SUPABASE_SECRET_KEY

# ── Auth behaviour ────────────────────────────────────────────────────────────
# Where Supabase sends the user after they click the confirmation / reset link.
SUPABASE_REDIRECT_URL=http://localhost:5173/auth/callback
