# MY DAY — Production Environment Configuration Template
# Copy this file to .env in your production environment and provide secure values.

# Server Configuration
PORT=3001
NODE_ENV=production

# Security & Sessions
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_secure_random_string_in_production

# Mobile Money Payment Gateway (Tigo Pesa, M-Pesa, Airtel Money) Webhook Secret
PAYMENT_WEBHOOK_SECRET=change_this_to_webhook_signing_secret

# Platform Timezone & Currency
PLATFORM_TIMEZONE=Africa/Dar_es_Salaam
PLATFORM_CURRENCY=TZS
DEFAULT_COMMISSION_RATE=0.05

# Optional Third-Party Services
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# SENDGRID_API_KEY=
